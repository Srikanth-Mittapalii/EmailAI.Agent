{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY_HERE",
    "Model": "gemini-2.0-flash"
  },
  "OpenRouter": {
    "ApiKey": "",
    "Model": "mistralai/mistral-7b-instruct:free"
  },
  "Groq": {
    "ApiKey": "YOUR_GROQ_API_KEY_HERE",
    "Model": "llama-3.3-70b-versatile"
  },
  "Sambanova": {
    "ApiKey": "YOUR_SAMBANOVA_API_KEY_HERE",
    "Model": "Meta-Llama-3.3-70B-Instruct"
  },
  "DeepSeek": {
    "ApiKey": "YOUR_DEEPSEEK_API_KEY_HERE",
    "Model": "deepseek-chat"
  },
  "HuggingFace": {
    "ApiKey": "YOUR_HUGGINGFACE_API_KEY_HERE",
    "EmbeddingModel": "sentence-transformers/all-MiniLM-L6-v2",
    "EmbeddingUrl": "https://api-inference.huggingface.co/pipeline/feature-extraction/sentence-transformers/all-MiniLM-L6-v2"
  },
  "MongoDB": {
    "ConnectionString": "YOUR_MONGODB_CONNECTION_STRING_HERE",
    "DatabaseName": "EmailAI",
    "CollectionName": "Emails"
  },
  "AppSettings": {
    "TokenLimit": 2000,
    "CacheDurationMinutes": 30,
    "ApiTimeout": 30
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "EmailAIAgent",
    "Audience": "EmailAIUsers"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID_HERE",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET_HERE"
  }
}
